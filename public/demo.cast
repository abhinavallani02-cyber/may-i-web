[0.019982, "o", "spawn node mayi.mjs --policy policy.yaml --audit /tmp/demo-recording-audit.jsonl -- node node_modules/@modelcontextprotocol/server-filesystem/dist/index.js ./sandbox\r\r\r\n"]
[1.9504, "o", "[CONFIG] policy: policy.yaml\r\r\n[CONFIG] audit mode: decisions only\r\r\nSecure MCP Filesystem Server running on stdio\r\r\n{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{},\"clientInfo\":{\"name\":\"demo\",\"version\":\"1.0\"}}}\r\r\n{\"result\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{\"listChanged\":true}},\"serverInfo\":{\"name\":\"secure-filesystem-server\",\"version\":\"0.2.0\"}},\"jsonrpc\":\"2.0\",\"id\":1}\r\r\n{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\",\"params\":{}}\r\r\nClient does not support MCP Roots, using allowed directories set from server args: [ '/private/tmp/mayi-demo2/sandbox' ]\r\r\n{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"read_text_file\",\"arguments\":{\"path\":\"hello.txt\"}}}\r\r\n"]
[1.950572, "o", "[INSPECT] id=2 tool=read_text_file args={\"path\":\"hello.txt\"}\r\r\n"]
[1.950678, "o", "[VERDICT] id=2 tool=read_text_file decision=allow\r\r\n"]
[1.953924, "o", "{\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"hello from the sandbox\\n\"}],\"structuredContent\":{\"content\":\"hello from the sandbox\\n\"}},\"jsonrpc\":\"2.0\",\"id\":2}\r\r\n"]
[2.558638, "o", "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"write_file\",\"arguments\":{\"path\":\"/etc/hosts\",\"content\":\"evil\"}}}\r\r\n"]
[2.558917, "o", "[INSPECT] id=3 tool=write_file args={\"path\":\"/etc/hosts\",\"content\":\"evil\"}\r\r\n"]
[2.559086, "o", "[VERDICT] id=3 tool=write_file decision=deny\r\r\n"]
[2.559273, "o", "{\"jsonrpc\":\"2.0\",\"id\":3,\"error\":{\"code\":-32602,\"message\":\"Blocked by policy: write_file (path_prefix: /etc)\"}}\r\r\n"]
[3.164206, "o", "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"tools/call\",\"params\":{\"name\":\"write_file\",\"arguments\":{\"path\":\"hello.txt\",\"content\":\"updated by the agent, approved by a human\"}}}\r\r\n"]
[3.164358, "o", "[INSPECT] id=4 tool=write_file args={\"path\":\"hello.txt\",\"content\":\"updated by the agent, approved by a human\"}\r\r\n"]
[3.167092, "o", "[ASK] id=4 tool=write_file args={\"path\":\"hello.txt\",\"content\":\"updated by the agent, approved by a human\"}. Approve? (y/n): "]
[3.67076, "o", "y\r\r\n"]
[3.671783, "o", "[VERDICT] id=4 tool=write_file decision=ask→approved\r\r\n"]
[3.975828, "o", "{\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"Successfully wrote to hello.txt\"}],\"structuredContent\":{\"content\":\"Successfully wrote to hello.txt\"}},\"jsonrpc\":\"2.0\",\"id\":4}\r\r\n"]
[4.480405, "o", "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"tools/call\",\"params\":{\"name\":\"read_text_file\",\"arguments\":{\"path\":\"hello.txt\"}}}\r\r\n"]
